# Setup:
#   useradd --system --no-create-home --shell /usr/sbin/nologin wirefox
#   wirefox-server init /etc/wirefox --data-dir /var/lib/wirefox --public-addr relay.example.com:7443
#   chown root:wirefox /etc/wirefox/server.toml && chmod 640 /etc/wirefox/server.toml
#   chown -R wirefox:wirefox /var/lib/wirefox
#   cp wirefox-server.service /etc/systemd/system/ && systemctl enable --now wirefox-server

[Unit]
Description=WireFox server
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/wirefox-server run -c /etc/wirefox/server.toml
User=wirefox
Group=wirefox
StateDirectory=wirefox
Restart=always
RestartSec=2
LimitNOFILE=1048576

# To listen on ports below 1024, replace the empty CapabilityBoundingSet=
# below with the two commented lines.
CapabilityBoundingSet=
#CapabilityBoundingSet=CAP_NET_BIND_SERVICE
#AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
